{
  "name": "pi-proxy",
  "version": "0.1.0",
  "type": "module",
  "description": "Explicit, session-owned Agent proxy recovery for Pi.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "proxy",
    "mihomo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollinlee/pi-proxy.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "!src/*.test.ts"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --test src/*.test.ts",
    "check:load": "pi --no-extensions -e . --list-models >/dev/null"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.19.19"
  },
  "exports": {
    ".": "./src/extension.ts",
    "./config": "./src/config.ts"
  }
}
